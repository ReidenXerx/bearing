node_modules/
.DS_Store
*.tar.gz
eval/report.md
eval/BENCHMARK-realrepo.md
eval/swebench/results/*/trajectories/
eval/swebench/results/*/config.yaml

# Python build artifacts
__pycache__/
*.pyc
.venv/

# Local databases / graph indexes
*.db
*.sqlite

# test residue (the suite runs hooks with cwd = this repo). Narrow on purpose: a blanket
# `.bearing/` would also hide the north-stars, which are meant to be committed and team-shared.
.bearing/.gitnexus-*
.bearing/.bearing-*
.bearing/.task-core.md
.bearing/skills/

# We dogfood bearing in its own repo (`npm run dogfood`), but the INSTALLED runtime artifacts stay
# untracked: they are byte-copies of bundle/, and a committed second copy invites editing the copy
# that never ships. bundle/ is the single source of truth; re-run the installer to refresh.
.bearing/lib/
.bearing/hooks.json
.claude/hooks/
.claude/settings.json
.vscode/
# Rendered from scripts/contract/ — edit the contract, run `npm run gen:contract`, then `npm run
# dogfood`. Committing the render invites editing it instead of the source it comes from.
CLAUDE.md
AGENTS.md
# npm pack artifacts
*.tgz

# bearing — generated local state (safe to remove via bearing-uninstall)
.bearing/.gitnexus-*
.bearing/.bearing-*
.bearing/.task-core.md
.bearing/task-cores/
*.bearing-backup
.bearing/manifest.json
.bearing/hooks.local.json
.claude/skills/
# --- end bearing ---

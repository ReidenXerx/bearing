{
  "name": "bearing",
  "version": "1.3.0",
  "description": "Your tests catch code that breaks; nothing catches an agent that has drifted about what the code means. A toolbelt for developers who already work with coding agents: north-stars that outrank stale docs, a task-core that survives compaction, ast-grep with its traps, review when you ask. No gates. Claude Code, Zed, Codex.",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReidenXerx/bearing.git"
  },
  "homepage": "https://github.com/ReidenXerx/bearing#readme",
  "bugs": {
    "url": "https://github.com/ReidenXerx/bearing/issues"
  },
  "bin": {
    "bearing": "./bin/cli.mjs",
    "bearing-update": "./bin/cli.mjs",
    "bearing-uninstall": "./bin/cli.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "kit:install": "./bin/install.sh",
    "install:target": "./bin/install.sh",
    "update:target": "./bin/update.sh",
    "uninstall:target": "./bin/uninstall.sh",
    "eval": "node eval/run-eval.mjs",
    "gen:contract": "node scripts/gen-contract.mjs",
    "test": "node --test lib/kit.test.mjs",
    "sync:meta": "node scripts/sync-repo-meta.mjs",
    "gen:diagrams": "node scripts/gen-diagrams.mjs",
    "dogfood": "if [ -f .bearing/manifest.json ]; then node lib/kit.mjs update . --no-setup --skip-verify; else node lib/kit.mjs install . --runtime claude --features northstars,goldpractices,taskcore,microscope,minions,tsjs --no-setup --skip-verify; fi",
    "release:notes": "node scripts/release-notes.mjs",
    "gen:skills": "node scripts/gen-skill-fragments.mjs",
    "gen:social": "node scripts/gen-social.mjs",
    "gen:social:html": "node scripts/gen-social-html.mjs"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agentic-ai",
    "claude",
    "claude-code",
    "zed",
    "codex",
    "llm",
    "mcp",
    "code-review",
    "context-engineering",
    "developer-tools"
  ],
  "license": "ISC",
  "files": [
    "bin",
    "lib",
    "bundle",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!lib/*.test.mjs"
  ],
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}

{
  "name": "bearing",
  "version": "1.0.5",
  "description": "An intel layer for AI coding agents — cognitive routines that keep them anchored to what your project actually is: authoritative north-stars, task-core across compaction, domain-expert review. Claude Code, Cursor, Zed, Codex.",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReidenXerx/bearing.git"
  },
  "homepage": "https://github.com/ReidenXerx/bearing#readme",
  "bugs": {
    "url": "https://github.com/ReidenXerx/bearing/issues"
  },
  "bin": {
    "bearing": "./bin/cli.mjs",
    "bearing-update": "./bin/cli.mjs",
    "bearing-uninstall": "./bin/cli.mjs"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "kit:install": "./bin/install.sh",
    "install:target": "./bin/install.sh",
    "update:target": "./bin/update.sh",
    "uninstall:target": "./bin/uninstall.sh",
    "eval": "node eval/run-eval.mjs",
    "gen:contract": "node scripts/gen-contract.mjs",
    "test": "node --test lib/kit.test.mjs lib/classify.test.mjs",
    "sync:meta": "node scripts/sync-repo-meta.mjs",
    "gen:diagrams": "node scripts/gen-diagrams.mjs",
    "dogfood": "node lib/kit.mjs install . --runtime claude --features northstars,taskcore,microscope --no-setup --skip-verify"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agentic-ai",
    "claude",
    "claude-code",
    "cursor",
    "zed",
    "codex",
    "llm",
    "mcp",
    "code-review",
    "context-engineering",
    "developer-tools"
  ],
  "license": "ISC",
  "files": [
    "bin",
    "lib",
    "bundle",
    "README.md",
    "LICENSE",
    "!lib/*.test.mjs"
  ]
}
